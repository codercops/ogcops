{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ogcops",
  // Built by `astro build` with @astrojs/cloudflare. Every page and the image
  // API render in the Worker; dist/ holds the client assets and fonts.
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // trailingSlash is 'never' in astro.config.mjs.
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // og.codercops.com is served through a route on a proxied placeholder DNS record
  // (AAAA 100::). www.og.codercops.com is a custom domain only so it gets a
  // certificate; a zone redirect rule 301s it to og.codercops.com.
  "routes": [
    { "pattern": "og.codercops.com/*", "zone_name": "codercops.com" },
    { "pattern": "www.og.codercops.com", "custom_domain": true }
  ],
  "workers_dev": false,
  // No per-branch Preview URLs: develop and production are the only
  // environments.
  "preview_urls": false
}
