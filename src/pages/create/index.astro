---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { EditorApp } from '@/components/editor/EditorApp';
import { getTemplateCount } from '@/templates/registry';
import '@/styles/editor.css';
import '@/styles/ai.css';

const templateCount = getTemplateCount();
---

<ToolLayout title="Create OG Image" description={`Design beautiful OG images with ${templateCount}+ templates. Free, no login required.`}>
  <EditorApp client:load />
</ToolLayout>
